{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "OwnPay",
  "description": "Self-hosted payment orchestrator with multi-brand support, white-label domains, and 100+ payment gateways.",
  "feedback": {
    "thumbsRating": true,
    "suggestEdit": true,
    "raiseIssue": true
  },
  "colors": {
    "primary": "#0178C8",
    "light": "#7EC8FC",
    "dark": "#4A6FA5"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://ownpay.org/docs"
  },
  "appearance": {
    "default": "system"
  },
  "fonts": {
    "family": "Inter"
  },
  "icons": {
    "library": "lucide"
  },
  "background": {
    "decoration": "gradient"
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "latex": true,
    "codeblocks": {
      "theme": {
        "light": "github-light",
        "dark": "github-dark"
      }
    }
  },
  "seo": {
    "indexing": "all",
    "trailingSlash": false,
    "metatags": {
      "og:site_name": "OwnPay Documentation",
      "og:locale": "en_US",
      "twitter:card": "summary_large_image",
      "twitter:site": "@ownpayorg",
      "robots": "index, follow, max-snippet:-1, max-image-preview:large",
      "canonical": "https://ownpay.org/docs",
      "fb:app_id": "1565186248495541",
      "og:image:alt": "OwnPay - Self-Hosted Payment Gateway Platform"
    },
    "organization": {
      "id": "https://ownpay.org/#organization",
      "name": "OwnPay",
      "legalName": "OwnPay Project",
      "url": "https://ownpay.org",
      "logo": "https://ownpay.org/docs/logo/light.svg",
      "sameAs": [
        "https://github.com/own-pay/OwnPay",
        "https://x.com/ownpayorg",
        "https://youtube.com/@ownpayorg",
        "https://facebook.com/ownpay.org"
      ]
    }
  },
  "metadata": {
    "timestamp": true
  },
  "search": {
    "prompt": "Search OwnPay docs..."
  },
  "banner": {
    "content": "OwnPay v{{version}} is available. [See what's new](/resources/changelog).",
    "dismissible": true,
    "type": "info"
  },
  "navbar": {
    "links": [
      {
        "type": "github",
        "href": "https://github.com/own-pay/OwnPay"
      },
      {
        "label": "ownpay.org",
        "href": "https://ownpay.org"
      },
      {
        "label": "Raise Issue",
        "href": "https://github.com/own-pay/OwnPay/issues/new"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get Started",
      "href": "/quickstart"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/own-pay/OwnPay",
      "website": "https://ownpay.org",
      "x": "https://x.com/ownpayorg",
      "facebook": "https://facebook.com/ownpay.org",
      "youtube": "https://youtube.com/@ownpayorg"
    },
    "links": [
      {
        "header": "Product",
        "items": [
          { "label": "Quickstart", "href": "/quickstart" },
          { "label": "Installation", "href": "/installation" },
          { "label": "Features", "href": "/resources/features" },
          { "label": "Roadmap", "href": "/resources/roadmap" },
          { "label": "Changelog", "href": "/resources/changelog" }
        ]
      },
      {
        "header": "Developers",
        "items": [
          { "label": "API Reference", "href": "/api/overview" },
          { "label": "API Quick Start", "href": "/developer/quickstart" },
          { "label": "Webhooks", "href": "/api/webhooks" },
          { "label": "Plugins", "href": "/developer/plugins/overview" }
        ]
      },
      {
        "header": "Resources",
        "items": [
          { "label": "Architecture", "href": "/resources/architecture" },
          { "label": "Security", "href": "/resources/security-compliance" },
          { "label": "FAQ", "href": "/resources/faq" },
          { "label": "Contributing", "href": "/resources/contributing" }
        ]
      }
    ]
  },
  "errors": {
    "404": {
      "redirect": false,
      "title": "Lost in transit?",
      "description": "The page you are looking for has moved or does not exist. Try the search bar at the top or explore these key sections:\n\n* **[Getting Started](/quickstart)** - Set up your self-hosted instance.\n* **[Installation](/installation)** - Deploy on shared hosting, VPS, or Docker.\n* **[API Reference](/api/overview)** - Merchant, Mobile, and Admin API specs.\n* **[Developer Hub](/developer/quickstart)** - Build custom plugins and integrations."
    }
  },
  "variables": {
    "version": "0.2.0",
    "github": "https://github.com/own-pay/OwnPay",
    "githubDocs": "https://github.com/own-pay/ownpay-docs",
    "githubWordpress": "https://github.com/own-pay/OwnPay-WordPress",
    "githubWhmcs": "https://marketplace.whmcs.com/product/8845-ownpay-whmcs",
    "website": "https://ownpay.org",
    "docsUrl": "https://ownpay.org/docs",
    "mcpUrl": "https://ownpay.org/docs/mcp",
    "skillsUrl": "https://ownpay.org/docs/skill.md",
    "supportEmail": "support@ownpay.org"
  },
  "interaction": {
    "drilldown": true
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "grok",
      "aistudio",
      "devin",
      "mcp",
      "add-mcp",
      "cursor",
      "vscode",
      "devin-mcp",
      "windsurf",
      "assistant",
      "download-spec",
      "download-pdf"
    ],
    "display": "toc"
  },
  "markdown": {
    "schema": true,
    "instructions": [
      "OwnPay is licensed under AGPL-3.0 and is completely free - no licensing fees.",
      "Production docs URL: https://ownpay.org/docs - append .md to any page URL for clean markdown.",
      "OwnPay requires PHP 8.3+, MySQL/MariaDB, and Redis.",
      "MCP server available at https://ownpay.org/docs/mcp for programmatic documentation queries.",
      "Use root-relative links (e.g. /quickstart) for internal navigation - do NOT include /docs prefix.",
      "Plugin development: consult /developer/plugins/ pages for correct interfaces and manifests.",
      "Canonical locations: API auth = /api/authentication, webhook verification = /api/webhooks, rate limits = /resources/rate-limiting, transaction statuses = /fundamentals/payment-flow.",
      "The documentation uses the Diataxis framework: Tutorials (learning), How-to (tasks), Reference (lookup), Explanation (understanding)."
    ]
  },
  "api": {
    "playground": {
      "display": "interactive",
      "proxy": true,
      "credentials": false,
      "url": "full"
    },
    "mdx": {
      "auth": {
        "method": "bearer",
        "name": "Authorization"
      }
    },
    "examples": {
      "languages": ["curl", "php", "python", "javascript", "go", "java"],
      "defaults": "required",
      "prefill": true
    }
  },
  "integrations": {
    "clarity": {
      "projectId": "xfbp4tcicy"
    },
    "telemetry": {
      "enabled": true
    }
  },
