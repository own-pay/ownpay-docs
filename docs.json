{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "OwnPay",
  "description": "Open-source, Self-hosted payment gateway with multi-brand support, white-label domains, and 100+ payment gateways.",
  "feedback": {
    "thumbsRating": true,
    "suggestEdit": true,
    "raiseIssue": true
  },
  "colors": {
    "primary": "#0F97ED",
    "light": "#5BB8F5",
    "dark": "#102963"
  },
